# ---------------------------------------------------------------------------
# LexIO Environment Configuration Template
# ---------------------------------------------------------------------------

# Backend / API Configuration
# Determines where the FastAPI backend runs or is accessed from
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Configuration
# URL of the backend API for the React/Vite frontend to call
VITE_API_URL=http://localhost:8000/api/v1

# Database Configuration
# Sync and Async URLs for the SQLite database
SYNC_DB_URL=sqlite:///./data/compliance_log.db
ASYNC_DB_URL=sqlite+aiosqlite:///./data/compliance_log.db

# Docker Environment
# Override settings when running via docker-compose
# DOCKER_ENV=true
