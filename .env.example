# ==============================================================
# LexIO - Institutional-Grade MVP Environment Configuration
# ==============================================================

# --- Blockchain / Web3 Settings ---
# Your Alchemy Sepolia RPC URL (e.g., https://eth-sepolia.g.alchemy.com/v2/...)
ALCHEMY_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"

# The Private Key of your test wallet (used to broadcast transactions)
# MUST HAVE SEPOLIA ETH FOR GAS. DO NOT USE A MAINNET WALLET KEY.
TESTNET_PRIVATE_KEY="your_testnet_private_key_here"

# --- Database Settings ---
# Local SQLite database URL
DATABASE_URL="sqlite+aiosqlite:///./data/compliance_log.db"

# --- API Settings ---
# Port and Host for the FastAPI server
HOST="0.0.0.0"
PORT="8000"

# --- AI Agent Settings ---
# Google Gemini API key for the LexIO AI Compliance Agent.
# Get a free key at: https://aistudio.google.com/app/apikey
# If not set, LexIO falls back to a high-quality rule-based narrative.
GEMINI_API_KEY="your_gemini_api_key_here"
